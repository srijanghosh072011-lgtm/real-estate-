---
interface Props {
  items: { q: string; a: string }[];
  title?: string;
  intro?: string;
}

const { items, title = 'Questions people ask before they call', intro } = Astro.props;
---

<section class="shell py-24 md:py-32" id="faq">
  <div class="grid gap-14 md:grid-cols-12">
    <div class="md:col-span-4">
      <span class="eyebrow">FAQ</span>
      <h2 class="mt-5 text-4xl leading-[1.05] md:text-5xl">{title}</h2>
      {intro && <p class="mt-5 max-w-sm text-[15px] leading-relaxed text-muted">{intro}</p>}
    </div>

    <div class="md:col-span-8">
      <div class="border-t border-line">
        {
          items.map((item, i) => (
            <details
              class="reveal group border-b border-line"
              style={`--reveal-delay:${i * 60}ms`}
              name="faq"
              open={i === 0}
            >
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-medium marker:hidden">
                <span class="font-display text-xl tracking-tight md:text-2xl">{item.q}</span>
                <span
                  class="mt-1 grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-open:rotate-45"
                  aria-hidden="true"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>
              <p class="max-w-2xl pb-7 text-[15px] leading-relaxed text-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
