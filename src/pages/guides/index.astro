---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
import { formatDate } from '../../lib/format';

const guides = (await getCollection('guides')).sort((a, b) => +b.data.published - +a.data.published);
const [lead, ...rest] = guides;
---

<Base
  title="Wilmington real estate guides and market reports"
  description="Pricing, due diligence, remote buying and short-term rental rules in coastal North Carolina — written by the brokers doing the transactions."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides' }]}
  schema={[
    {
      '@type': 'Blog',
      name: `${site.name} guides`,
      url: `${site.url}/guides`,
      publisher: { '@id': `${site.url}/#organization` },
    },
  ]}
>
  <section class="shell pt-32 md:pt-44">
    <span class="eyebrow reveal">Guides</span>
    <h1 class="reveal mt-6 max-w-3xl text-[clamp(2.5rem,6vw,4.5rem)] leading-[0.98]" style="--reveal-delay:80ms">
      The things we end up explaining on every call.
    </h1>
    <p class="reveal mt-7 max-w-xl text-[16px] leading-relaxed text-muted" style="--reveal-delay:140ms">
      Written to be useful whether or not you ever hire us. If something here is out of date, tell us and we will fix
      it.
    </p>
  </section>

  <section class="shell mt-16">
    <a href={`/guides/${lead.id}`} class="reveal bezel group block">
      <div class="bezel-core grid overflow-hidden lg:grid-cols-2">
        <div class="photo relative min-h-[16rem] lg:min-h-[26rem]">
          <img
            src={lead.data.heroImage}
            alt={lead.data.heroAlt}
            width="1000"
            height="700"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03]"
          />
        </div>
        <div class="flex flex-col justify-center p-8 md:p-12">
          <span class="text-xs uppercase tracking-[0.18em] text-brass-deep">{lead.data.category}</span>
          <h2 class="mt-5 text-3xl leading-[1.08] tracking-tight md:text-4xl">{lead.data.title}</h2>
          <p class="mt-5 text-[15px] leading-relaxed text-muted">{lead.data.description}</p>
          <p class="mt-8 text-xs text-muted">
            {lead.data.author} · {formatDate(lead.data.published)} · {lead.data.readMinutes} min read
          </p>
        </div>
      </div>
    </a>
  </section>

  <section class="shell mt-5 grid gap-5 md:grid-cols-3">
    {
      rest.map((g, i) => (
        <a href={`/guides/${g.id}`} class="reveal bezel group" style={`--reveal-delay:${i * 80}ms`}>
          <div class="bezel-core flex h-full flex-col overflow-hidden">
            <div class="photo aspect-[16/10] overflow-hidden">
              <img
                src={g.data.heroImage}
                alt={g.data.heroAlt}
                width="700"
                height="437"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
              />
            </div>
            <div class="flex flex-1 flex-col p-7">
              <span class="text-xs uppercase tracking-[0.18em] text-brass-deep">{g.data.category}</span>
              <h2 class="mt-4 text-xl leading-snug tracking-tight">{g.data.title}</h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{g.data.description}</p>
              <p class="mt-6 text-xs text-muted">{formatDate(g.data.published)} · {g.data.readMinutes} min</p>
            </div>
          </div>
        </a>
      ))
    }
  </section>

  <CtaBand
    title="Still have a question?"
    body="Ask it directly. We answer questions from people who are years away from moving, because that is how this works."
    primary={{ label: 'Ask a broker', href: '/contact' }}
  />
</Base>
