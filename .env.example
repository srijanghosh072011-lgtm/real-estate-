# Copy to .env and fill in. Never commit .env — it is gitignored.
# Used only by scripts/sync-listings.mjs; the site build needs none of this.

# CREA DDF® or IDX vendor feed (Redman, MyRealPage, RealtyNinja, Showcase IDX…)
DDF_URL=
DDF_USER=
DDF_PASS=
DDF_AGENT_ID=

# Everything the browser needs lives in data/site.json, not here:
#   forms.accessKey        Web3Forms / Formspree key (public by design)
#   forms.turnstileSiteKey Cloudflare Turnstile site key (public by design)
#   analytics.endpoint     where behaviour events are POSTed
#   analytics.ga4Id        optional GA4 measurement ID
